#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

pnpm exec lint-staged

# Avoid `yarn` here: on Windows it can resolve to a global shim under a path with
# non-ASCII chars, which breaks Node module resolution. Call the local CLI directly.
NODE_ENV=development pnpm exec lingui extract --clean --overwrite --locale en
pnpm exec lingui compile
git add ./src/locales
